# Copy to deploy/.env (gitignored). All values optional.
# HARMONY uses the OpenAI Responses API only when both are set; otherwise scripted replies.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=model-id-from-the-openai-models-page
# When set, creating a session asks for this key (the app is also behind Caddy basic auth).
GUIDE_CREATE_KEY=
