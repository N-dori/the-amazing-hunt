{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Bash(cat *.env)",
      "Bash(cat */.env)",
      "Bash(less *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(grep * *.env)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm run build*)",
      "Bash(docker compose down*)",
      "Bash(docker stop dori-platform*)",
      "Bash(docker stop dori-site*)",
      "Bash(docker restart dori-platform*)"
    ]
  }
}
